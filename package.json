{
  "name": "academia_system",
  "version": "1.0.0",
  "description": "Projeto da APS da disciplina de Desenvolvimento Back-End, 4P - Engenharia de Software - Campus SJP",
  "keywords": [
    "back-end",
    "ts",
    "js",
    "API",
    "academia",
    "gym",
    "microservice"
  ],
  "author": "Eduardo Lopes e Diogo Yudi",
  "license": "ISC",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:unit": "vitest run src/tests/unit",
    "test:watch": "vitest src/tests/unit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:integration": "node scripts/test.mjs --integration",
    "test:coverage": "node scripts/test.mjs --coverage"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "express": "^5.2.1"
  }
}
